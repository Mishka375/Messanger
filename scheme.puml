@startuml

!theme amiga

skinparam linetype ortho
allowmixing

skinparam nodesep 24
skinparam ranksep 10
skinparam padding 4

' ============ USER ============

package user <<Node>> {
  rectangle Register <<interface>> {
    rectangle "name" as reg_name

    rectangle "login" as reg_login

    rectangle "password" as reg_password
    rectangle "password_confirmation" as reg_password_confirmation
  }

  rectangle Enter <<interface>> {
    rectangle "login" as ent_login
    rectangle "password" as ent_password
  }

  rectangle Chat_menu <<interface>> {
    rectangle "choose_chat"
    rectangle "friends_menu"

    rectangle "session_key" as chat_menu_session_key
  }
}


' ============ SERVER ============

package server <<Node>> {

  package kubernetis <<Node>> {
    class none {
    }
  }

  package databases <<Data>> {
    package Redis <<Database>> {
      database "session_keys" {
        rectangle "key" as session_keys_key
        rectangle "user_id" as session_keys_user_id
      }
    }

    package PostgreSQL <<Database>> {
      database "user_db" {
        rectangle user <<Table>> {
          rectangle "id" as user_id
          rectangle "login" as user_login
          rectangle "password" as user_password
        }

        rectangle personal <<Table>> {
          rectangle "id" as personal_id
          rectangle "identificator" as personal_identificator
          rectangle "name" as personal_name
        }
      }

      database "chat_db" {
        rectangle chats <<Table>> {
          rectangle "id" as chats_id
          rectangle "user_1" as chats_user_1
          rectangle "user_2" as chats_user_2
        }

        rectangle messages <<Table>> {
          rectangle "date" as messages_date
          rectangle "user_id" as messages_user_id
          rectangle "chat_id" as messages_chat_id
          rectangle "text" as messages_text
        }
      }
    }
  }

  package backend <<System>> {
    enum Error_codes <<enumeration>> {
      100: REDIS_ERROR
      101: REDIS_DATA_ERROR
      102: REDIS_TIMEOUT_ERROR
      103: REDIS_BUSY_ERROR
      ..
      200: SQL_ERROR
      201: SQL_VALUE_ERROR
      202: SQL_IS_BULL_ERROR
      203: SQL_REQUEST_ERROR
      204: SQL_DATA_ERROR
      ..
      300: INCORRECT_DATA
      301: INCORRECT_LOGIN
      302: INCORRECT_ENTER
      303: INCORRECT_KEY
      304: INCORRECT_CONNECT
      ..
      400: CHAT_ERROR
    }
  }

  package monitoring <<Monitoring>> {
    class grafana {
      - display
    }

    class prometheus {
      - total_users
      - users_online
      - errors
    }
  }
}

' ============ DEPENDENCIES ============

user -left..> kubernetis

kubernetis -down..> backend
kubernetis -down..> databases

user_id -right-> personal_id
user_id -right-> messages_user_id
user_id -right-> chats_user_1
user_id -right-> chats_user_2
chats_id -right-> messages_chat_id

user_id -left->  session_keys_user_id


reg_login ..> user_login
reg_password ..> user_password
reg_name ..> personal_name

user_login ..> ent_login
user_password ..> ent_password

session_keys_key ..> chat_menu_session_key

prometheus ..> grafana

' ============ HIDDEN ============

databases -[hidden]down- monitoring
backend -[hidden]right- monitoring

session_keys_key -[hidden]right- session_keys_user_id

PostgreSQL -[hidden]down- Redis

' ============ NOTES ============


@enduml